{
  "version": "1.9.0",
  "log-level": 3,
  "source": [
    {
      "alias": "S1",
      "name": "ORCL",
      "reader": {
        "type": "online",
        "user": "OLR_CDC",
        "password": "REPLACE_WITH_DATABASE_PASSWORD",
        "server": "//127.0.0.1:1521/ORCL"
      },
      "format": {
        "type": "json"
      },
      "state": {
        "type": "disk",
        "path": "checkpoint",
        "interval-s": 10,
        "keep-checkpoints": 100
      },
      "memory": {
        "min-mb": 64,
        "max-mb": 1024,
        "swap-path": "swap"
      },
      "filter": {
        "table": [
          {
            "owner": "OLR_TEST",
            "table": "CDC_TEST"
          }
        ]
      }
    }
  ],
  "target": [
    {
      "alias": "ZEROMQ",
      "source": "S1",
      "writer": {
        "type": "zeromq",
        "uri": "tcp://127.0.0.1:15082",
        "max-message-mb": 10
      }
    }
  ]
}